# 이 파일을 복사해서 이름을 .env 로 바꾸고, 발급받은 키를 = 뒤에 붙여넣으세요.
# .env 는 .gitignore 에 들어 있어서 GitHub 에 올라가지 않습니다. (절대 올리지 마세요)
# GitHub Actions 에서는 이 파일 대신 저장소 Settings > Secrets and variables > Actions 의 Secrets 를 씁니다.

# 시세 자동 갱신 (scripts/update_prices.py) — 국내 리츠·리츠 ETF 전일 종가
# 공공데이터포털(data.go.kr) 인증키. '금융위원회_주식시세정보', '금융위원회_증권상품시세정보' 두 API 모두 활용신청 필요
DATA_GO_KR_KEY=
# (선택) 미국 리츠까지 갱신할 때만. finnhub.io 무료 키는 '개인 용도' 조건이라 팀이 정해서 넣으세요
FINNHUB_API_KEY=

# 국내 리츠 배당 자동 갱신 (scripts/fetch_dividends.py, 일주일에 한 번) — opendart.fss.or.kr
DART_API_KEY=

# 그 밖의 공식 API 데이터 스크립트 (scripts/build_all.py 등, 지금은 안 씀)
FINLIFE_API_KEY=
JUSO_SEARCH_KEY=
JUSO_COORD_KEY=
