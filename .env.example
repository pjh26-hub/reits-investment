# 이 파일을 복사해서 이름을 .env 로 바꾸고, 발급받은 키를 = 뒤에 붙여넣으세요.
# .env 는 .gitignore 에 들어 있어서 GitHub 에 올라가지 않습니다. (절대 올리지 마세요)
# GitHub Actions 에서는 이 파일 대신 저장소 Settings > Secrets and variables > Actions 의 Secrets 를 씁니다.

# 시세 자동 갱신 (scripts/update_prices.py)
KIS_APP_KEY=
KIS_APP_SECRET=
# 모의투자 앱키를 쓸 때만 demo 로 바꾸세요 (기본 real)
KIS_ENV=real
FINNHUB_API_KEY=

# 공식 API 데이터 스크립트 (scripts/build_all.py 등)
DATA_GO_KR_KEY=
DART_API_KEY=
FINLIFE_API_KEY=
JUSO_SEARCH_KEY=
JUSO_COORD_KEY=
